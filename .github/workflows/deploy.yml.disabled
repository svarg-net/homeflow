name: Deploy HomeFlow

on:
  push:
    branches:
      - main
      - dev

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # Динамически определяем параметры деплоя в зависимости от целевой ветки
      - name: Set Environment Variables
        id: set-env
        run: |
          if [ "${{ github.ref_name }}" = "main" ]; then
            echo "host=${{ secrets.PROD_SERVER_HOST }}" >> $GITHUB_OUTPUT
            echo "user=${{ secrets.PROD_SERVER_USER }}" >> $GITHUB_OUTPUT
            echo "key=${{ secrets.PROD_SERVER_SSH_KEY }}" >> $GITHUB_OUTPUT
            echo "compose_file=deploy/production/docker-compose.prod.yml" >> $GITHUB_OUTPUT
          else
            echo "host=${{ secrets.DEV_SERVER_HOST }}" >> $GITHUB_OUTPUT
            echo "user=${{ secrets.DEV_SERVER_USER }}" >> $GITHUB_OUTPUT
            echo "key=${{ secrets.DEV_SERVER_SSH_KEY }}" >> $GITHUB_OUTPUT
            echo "compose_file=deploy/development/docker-compose.dev.yml" >> $GITHUB_OUTPUT
          fi

      # Подключение по SSH и выполнение команд обновления на сервере
      - name: Setup SSH Connection & Deploy
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ steps.set-env.outputs.host }}
          username: ${{ steps.set-env.outputs.user }}
          key: ${{ steps.set-env.outputs.key }}
          port: 22
          script: |
            # Переходим в рабочую директорию проекта на сервере
            cd /var/www/homeflow
            
            # Скачиваем свежий код из соответствующей ветки (main или dev)
            git pull origin ${{ github.ref_name }}
            
            # Пересобираем и запускаем production/development контейнеры в фоне
            docker compose -f ${{ steps.set-env.outputs.compose_file }} up -d --build
            
            # Устанавливаем PHP-зависимости внутри контейнера приложения
            docker compose -f ${{ steps.set-env.outputs.compose_file }} exec -T app composer install --no-dev --optimize-autoloader
            
            # Применяем миграции базы данных PostgreSQL 18
            docker compose -f ${{ steps.set-env.outputs.compose_file }} exec -T app php artisan migrate --force
            
            # Сбрасываем и обновляем конфигурационный кэш Laravel 13
            docker compose -f ${{ steps.set-env.outputs.compose_file }} exec -T app php artisan config:cache
            docker compose -f ${{ steps.set-env.outputs.compose_file }} exec -T app php artisan route:cache
            
            # Мягко перезапускаем сервер Roadrunner для применения изменений без даунтайма
            docker compose -f ${{ steps.set-env.outputs.compose_file }} exec -T app rr reset
