# homeflow/backend/.env.example
APP_NAME=Homeflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# База данных (PostgreSQL 18)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=homeflow
DB_USERNAME=homeflow_user
DB_PASSWORD=homeflow_password

# Redis 8.x
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# Laravel Octane + RoadRunner
OCTANE_SERVER=roadrunner
ROADRUNNER_COMMAND=rr serve -c .rr.yaml

# Laravel Reverb (WebSockets)
REVERB_APP_ID=homeflow-app
REVERB_APP_KEY=homeflow-key
REVERB_APP_SECRET=homeflow-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Очереди
QUEUE_CONNECTION=redis

# Мессенджеры (заглушки для примера)
TELEGRAM_BOT_TOKEN=
VK_SERVICE_TOKEN=